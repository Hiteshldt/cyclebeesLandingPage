# Copy to .env.local and fill in. Never commit real values.

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Mailbox that receives website enquiries (Zoho).
CONTACT_INBOX=mail@cyclebees.in

# Envelope sender. Must be an address on the domain verified in Resend.
# Kept separate from the Zoho mailboxes so replies still land in Zoho:
# outbound goes through Resend, inbound MX stays with Zoho.
CONTACT_FROM="CycleBees Website <website@cyclebees.in>"

# Canonical origin used for SEO tags, sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.cyclebees.in
